{
  "name": "@devleague/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/main.ts"
  },
  "dependencies": {
    "@devleague/application": "workspace:*",
    "@devleague/persistence": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
