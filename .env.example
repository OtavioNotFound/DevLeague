NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EXPERIMENTAL_CPP=false

# Configure somente quando a integração for implementada.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_AUDIENCE=authenticated
ALPHA_TERMS_VERSION=v0.1-alpha
ALPHA_PRIVACY_VERSION=v0.1-alpha
REQUIRE_VERIFIED_EMAIL=false
REDIS_URL=
MATCHMAKING_REGION=br-sa-east
MATCHMAKING_ENABLED=false
MATCHMAKING_EMBEDDED=false
# Exige worker implantado, provider real e calibração aprovada.
COMPETITIVE_EXECUTION_ENABLED=false
# Exceção casual: somente UNRANKED_PUBLIC, valida exemplos públicos no navegador,
# registra o resultado como não verificado e nunca altera rating.
ALPHA_BROWSER_MATCHES_UNRANKED=false
# Mantenha false até existir judge real, worker implantado e suíte de calibração aprovada.
RANKED_MATCHMAKING_ENABLED=false
MATCHMAKER_RECOVERY_MS=30000
DATABASE_URL=
# Desenvolvimento bloqueia bancos remotos por padrão para não tocar produção acidentalmente.
ALLOW_REMOTE_DATABASE=false
# Banco PostgreSQL descartável dedicado aos testes de integração.
TEST_DATABASE_URL=
TEST_REDIS_URL=
JUDGE_PROVIDER=
# Somente desenvolvimento local. Nunca habilitar em produção.
ALLOW_FAKE_JUDGE=false
FAKE_JUDGE_DEFAULT=
JUDGE_API_URL=
JUDGE_API_KEY=
RUNTIME_PYTHON=3.13
RUNTIME_JAVA=21
RUNTIME_JAVASCRIPT=24
RUNTIME_TYPESCRIPT=5.9
RUNTIME_LUA=5.3
RUNTIME_CPP=23
WORKER_POLL_MS=250
MATCH_LIFECYCLE_ENABLED=true
MATCH_LIFECYCLE_POLL_MS=500
MATCH_RESOLUTION_GRACE_SECONDS=60
PRACTICE_RUN_RATE_LIMIT_PER_MINUTE=10
PRACTICE_SUBMIT_RATE_LIMIT_PER_MINUTE=5
MATCH_SUBMIT_RATE_LIMIT_PER_MINUTE=5
