{
  "name": "devleague",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --sort run build",
    "typecheck": "pnpm build && pnpm --recursive --sort run typecheck",
    "test": "pnpm --recursive --sort run test",
    "test:integration": "pnpm --filter @devleague/persistence test:integration && pnpm --filter @devleague/redis-infrastructure test:integration",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:api": "pnpm --filter @devleague/api start:dev",
    "dev:worker": "pnpm --filter @devleague/worker start:dev",
    "dev:matchmaker": "pnpm --filter @devleague/matchmaker start:dev",
    "dev:web": "pnpm --filter @devleague/web dev",
    "db:migrate": "pnpm --filter @devleague/persistence build && pnpm --filter @devleague/persistence migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
